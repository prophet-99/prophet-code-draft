---
import LinkButton from "./LinkButton.astro"
import ProjectTags from "./ProjectTags.astro"
import LinkIcon from "./icons/Link.astro"
import { getProjectCaseStudyPath, PROJECTS } from "@/data/projects"
import { getTranslations, type Locale } from "@/i18n/translations"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getTranslations(locale)
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(
      ({ id, image, tags, preview, caseStudy }) => (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
          <div class="w-full md:w-1/2">
            <div
              transition:name={`project-image-${id}`}
              class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50"
            >
              <img
                alt={`${copy.projectsUi.imageAlt}: ${copy.projects[id].title}`}
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                src={image}
              />
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg">
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {copy.projects[id].title}
            </h3>
            <div class="flex flex-wrap mt-2">
              <div class="mb-2">
                <ProjectTags tags={tags} />
              </div>
              <div class="mt-2 text-gray-700 dark:text-gray-400">{copy.projects[id].description}</div>
              <footer class="flex flex-wrap items-end justify-start mt-4 gap-3">
                  <a
                    href={getProjectCaseStudyPath(locale, caseStudy.slug)}
                    class="inline-flex items-center justify-center gap-2 rounded-xl border border-yellow-500/60 bg-yellow-400/10 px-3 py-2 text-base font-medium text-gray-800 transition hover:border-yellow-500 hover:bg-yellow-400/20 focus:outline-none focus-visible:ring focus-visible:ring-yellow-500/80 focus-visible:ring-offset-2 dark:text-white dark:focus-visible:ring-offset-neutral-950"
                  >
                    {copy.projectsUi.caseStudy}
                    <span aria-hidden="true">→</span>
                  </a>
                  {preview.status === "available" ? (
                    <LinkButton href={preview.url}>
                      <LinkIcon class="size-4" />
                      {copy.projectsUi.preview}
                    </LinkButton>
                  ) : (
                    <span
                      aria-disabled="true"
                      class="inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-xl border border-gray-300 bg-gray-100 px-3 py-2 text-base text-gray-500 opacity-75 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
                    >
                      {copy.projectsUi.comingSoon}
                    </span>
                  )}
                </footer>
            </div>
          </div>
        </article>
      )
    )
  }
</div>
