---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"
import { getTranslations, type Locale } from "@/i18n/translations"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getTranslations(locale)
const THEMES = [
  { value: "light", label: copy.theme.light },
  { value: "dark", label: copy.theme.dark },
  { value: "system", label: copy.theme.system },
]
---

<div class="relative ml-1 mr-1">
  <button
    id="theme-toggle-btn"
    type="button"
    class="appearance-none border-none flex hover:scale-125 transition"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="themes-menu"
  >
    <span class="sr-only">{copy.theme.label}</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>
  <div
    id="themes-menu"
    class="absolute hidden scale-80 top-8 right-0 text-sm p-1 min-w-[8rem] rounded-md border border-gray-100 bg-white/90 dark:bg-gray-900/90 dark:border-gray-500/20 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md"
  >
    <ul role="menu">
      {
        THEMES.map((theme) => (
          <li role="none">
            <button
              role="menuitemradio"
              aria-checked="false"
              type="button"
              data-theme={theme.value}
              class="themes-menu-option block w-full px-2 py-1.5 text-left hover:bg-neutral-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            >
              {theme.label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  let remove = null
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)")
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined") {
      return localStorage.getItem("theme") ?? "system"
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light"
  }

  const updateIcon = (themePreference) => {
    document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
      element.style.scale = element.id === themePreference ? "1" : "0"
    })
    document.querySelectorAll("[data-theme]").forEach((element) => {
      element.setAttribute("aria-checked", String(element.getAttribute("data-theme") === themePreference))
    })
  }

  const updateTheme = () => {
    if (remove != null) {
      remove()
    }
    matchMedia.addEventListener("change", updateTheme)
    remove = () => {
      matchMedia.removeEventListener("change", updateTheme)
    }

    const themePreference = getThemePreference()
    const isDark =
      themePreference === "dark" ||
      (themePreference === "system" && matchMedia.matches)

    updateIcon(themePreference)
    document.documentElement.classList[isDark ? "add" : "remove"]("dark")
  }

  updateTheme()

  document.addEventListener("click", (event) => {
    const target = event.target
    if (!(target instanceof Element)) return

    const themesMenu = document.getElementById("themes-menu")
    const themeButton = target.closest("#theme-toggle-btn")
    const themeOption = target.closest("[data-theme]")

    if (themeButton) {
      event.stopPropagation()
      const isOpen = !themesMenu?.classList.contains("open")
      themesMenu?.classList.toggle("open", isOpen)
      themeButton.setAttribute("aria-expanded", String(isOpen))
      return
    }

    if (themeOption instanceof HTMLElement) {
      const theme = themeOption.dataset.theme
      if (theme) localStorage.setItem("theme", theme)
      updateTheme()
    }

    themesMenu?.classList.remove("open")
    document.getElementById("theme-toggle-btn")?.setAttribute("aria-expanded", "false")
  })

  document.addEventListener('astro:after-swap', () => {
    updateTheme();
    window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
  })
</script>
