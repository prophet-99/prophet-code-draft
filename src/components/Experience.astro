---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
  {
    date: "Febrero 2026 - Actualmente",
    title: "Full Stack AI Developer",
    company: "Minsait | Cliente: MAEUEC España",
    description:
      "Desarrollo soluciones full stack basadas en inteligencia artificial, integrando frontend y backend para casos de visión artificial y detección en tiempo real. Trabajo con React, Angular, FastAPI y MediaPipe para construir experiencias interactivas y eficientes. Además, optimicé un chatbot con n8n para automatizar el registro de información y mejorar flujos operativos internos.",
    tools:
      "JavaScript, TypeScript, Python, React, Angular, FastAPI, MediaPipe, n8n",
  },
  {
    date: "Octubre 2024 - Enero 2026",
    title: "Full Stack Developer (Frontend focus)",
    company: "Encora | Cliente: BCP Perú",
    description:
      "Desarrollé y mantuve funcionalidades para Cocos y Lucas, producto de BCP enfocado en cambio de divisas. Trabajé principalmente con Angular, aplicando patrones, buenas prácticas y mejoras de interfaz en una arquitectura productiva sobre AWS CloudFront y WAF. También participé en integraciones con Redis para intercambio de datos entre frontends, monitoreo con Grafana y flujos de CI/CD con Jenkins.",
    tools:
      "JavaScript, TypeScript, Angular, AWS, Jenkins, GTM, Figma, Zeplin, Spring Boot, Redis, Grafana",
  },
  {
    date: "Octubre 2022 - Septiembre 2024",
    title: "Full Stack Developer (Frontend focus)",
    company: "Minsait PE | Cliente: MAEUEC España",
    description:
      "Lideré la arquitectura frontend y la definición de estándares visuales para aplicaciones Angular y Vanilla JavaScript. Implementé guías de estilo, componentes reutilizables con Storybook y propuse una arquitectura de microfrontends con Module Federation. También migré una aplicación de Angular 8 a Angular 16, optimizando el bundle, y desarrollé APIs y microservicios con Spring Boot y Node.js/Express.",
    tools:
      "JavaScript, TypeScript, Java, Angular, Microfrontends, Storybook, Spring Boot, Webpack Bundle Analyzer, Bundlephobia, Docker",
  },
  {
    date: "Agosto 2019 - Septiembre 2022",
    title: "Full Stack AI Developer",
    company: "CIMA Perú",
    description:
      "Desarrollé soluciones educativas full stack, incluyendo una aplicación de aprendizaje de inglés con IA en Flutter e integración de modelos de texto a voz. Lideré la arquitectura frontend en Angular y propuse Clean Architecture para mejorar la mantenibilidad. También formé a becarios, creé una plataforma de aula virtual con React/Konva y migré sistemas monolíticos en jQuery/PHP hacia TypeScript y Webpack 5.",
    tools:
      "Java, Angular, React, Flutter, TypeScript, JavaScript, Sass, Figma, Firebase, Spring Boot, Node.js, PostgreSQL, Webpack 5, Konva, jQuery, PHP, Text-to-Speech, AI Models",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
