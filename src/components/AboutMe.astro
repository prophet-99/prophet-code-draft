---
import { getTranslations, type Locale } from "@/i18n/translations"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getTranslations(locale)
const personalImageAlt = "Alexander Avila"
---

<article class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row">
  <div class="[&>p]:mb-4 [&>p>strong]:text-red-500 dark:[&>p>strong]:text-red-300 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1">
    <p> 
      {copy.about.introStart}<strong>{copy.about.role}</strong>{copy.about.introMiddle}<strong>{copy.about.specialties}</strong>{copy.about.introEnd}
    </p>

    <p>
      {copy.about.backgroundStart}<strong>{copy.about.countries}</strong>{copy.about.backgroundMiddle}<strong>{copy.about.angular}</strong>{copy.about.backgroundEnd}
      <br /> {copy.about.certificationsStart}<strong>{copy.about.ocp}</strong>{copy.about.certificationsMiddle}<strong>{copy.about.aws}</strong>{copy.about.certificationsEnd}
    </p>

    <p>
      {copy.about.contentStart}<strong>{copy.about.edteam}</strong>{copy.about.contentMiddle}<strong>{copy.about.prophetCode}</strong>{copy.about.contentEnd}
    </p>
  </div>

  <img
    class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-red-500/5 ring-1 ring-black/70 dark:ring-white/20"
    style="object-position: 50% 50%"
    width="200"
    height="200"
    src="/me.webp"
    alt={ personalImageAlt }
  />
</article>
