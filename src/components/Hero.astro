---
import Badge from "@/components/Badge.astro"
import SocialPill from "@/components/SocialPill.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import YouTubeIcon from '@/components/icons/YouTube.astro';
import GmailIcon from '@/components/icons/Gmail.astro';
import TikTokIcon from "@/components/icons/TikTok.astro";
import InstagramIcon from "@/components/icons/Instagram.astro";
import TwitchIcon from "@/components/icons/Twitch.astro";
import { getTranslations, type Locale } from "@/i18n/translations"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getTranslations(locale)
const personalImageAlt = "Alexander Avila";
---
<style>
  .sh-blinker {
    animation: blinker-animation 800ms infinite;
  }
  @keyframes blinker-animation {
    0% { color: inherit; }
    50% { color: transparent; }
    100% { color: inherit; }
  }
</style>

<div class="max-w-2xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/prophet-code.webp"
      alt={ personalImageAlt }
    />
    <a
      href="https://www.linkedin.com/in/alexander-avila-briones"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{copy.hero.available}</Badge>
    </a>
  </div>
  <h1 class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white min-h-[85px] sm:min-h-[auto]">
    {copy.hero.greeting}
    <span class="js-typed-name"></span>
    <span class="sh-blinker">|</span>
    <span class="text-3xl sm:text-4xl">😼</span>
  </h1>
  <p class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-red-300 [&>strong]:text-red-500 [&>strong]:font-semibold dark:text-gray-300">
    {copy.hero.summaryStart}<strong>{copy.hero.summaryHighlight}</strong>{copy.hero.summaryEnd}
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:prophet.code99@gmail.com">
      <GmailIcon class="size-3.5" />
      Gmail
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/alexander-avila-briones">
      <LinkedInIcon class="size-3.5" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://www.youtube.com/@prophetcode">
      <YouTubeIcon class="size-3.5" />
      YouTube
    </SocialPill>
    <SocialPill href="https://www.twitch.tv/prophetcode">
      <TwitchIcon class="size-3.5" />
      Twitch
    </SocialPill>
    <SocialPill href="https://www.tiktok.com/@prophetcode.dev">
      <TikTokIcon class="size-3.5" />
      TikTok
    </SocialPill>
    <SocialPill href="https://www.instagram.com/prophetcode.dev">
      <InstagramIcon class="size-3.5" />
      Instagram
    </SocialPill>
  </nav>
</div>

<script>
  const toType = ['Alexander Avila', 'Prophet Code'];
  const delayTypingChar = 120;
  const delayErasingText = 100;
  const delayTypingText = 900;

  let typingTimeout: number | undefined;
  let animationId = 0;

  const stopTypingAnimation = () => {
    animationId++;
    if (typingTimeout !== undefined) window.clearTimeout(typingTimeout);
    typingTimeout = undefined;
  };

  const startTypingAnimation = () => {
    stopTypingAnimation();

    const typedTarget = document.querySelector<HTMLElement>('.js-typed-name');
    if (!typedTarget) return;

    const currentAnimationId = animationId;
    let toTypeIndex = 0;
    let charIndex = 0;
    typedTarget.textContent = '';

    const schedule = (callback: () => void, delay: number) => {
      typingTimeout = window.setTimeout(() => {
        if (currentAnimationId !== animationId || !typedTarget.isConnected) return;
        callback();
      }, delay);
    };

    const eraseText = () => {
      if (charIndex > 0) {
        charIndex--;
        typedTarget.textContent = toType[toTypeIndex].substring(0, charIndex);
        schedule(eraseText, delayErasingText);
        return;
      }

      toTypeIndex = (toTypeIndex + 1) % toType.length;
      schedule(typeText, delayTypingText);
    };

    const typeText = () => {
      if (charIndex < toType[toTypeIndex].length) {
        typedTarget.textContent += toType[toTypeIndex].charAt(charIndex);
        charIndex++;
        schedule(typeText, delayTypingChar);
        return;
      }

      schedule(eraseText, delayTypingText);
    };

    schedule(typeText, delayTypingText);
  };

  document.addEventListener('astro:before-swap', stopTypingAnimation);
  document.addEventListener('astro:page-load', startTypingAnimation);
</script>
