---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import ProjectTags from "@/components/ProjectTags.astro"
import LinkButton from "@/components/LinkButton.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkIcon from "@/components/icons/Link.astro"
import CaseStudyBlocks from "@/components/CaseStudyBlocks.astro"
import { getCaseStudyContent } from "@/content/projects"
import {
  getProjectById,
  getProjectCaseStudyPath,
  type CaseStudyProjectId,
} from "@/data/projects"
import { getLocalePath, getTranslations, type Locale } from "@/i18n/translations"

interface Props {
  locale: Locale
  projectId: CaseStudyProjectId
}

const { locale, projectId } = Astro.props
const copy = getTranslations(locale)
const project = getProjectById(projectId)
const caseStudy = project.caseStudy
const article = getCaseStudyContent(projectId, locale)

const projectCopy = copy.projects[projectId]
const localizedPaths = {
  en: getProjectCaseStudyPath("en", caseStudy.slug),
  es: getProjectCaseStudyPath("es", caseStudy.slug),
}
const projectListPath = `${getLocalePath(locale)}#proyectos`
---

<Layout
  title={`${projectCopy.title} | Prophet Code`}
  description={caseStudy.metaDescription[locale]}
  locale={locale}
  localizedPaths={localizedPaths}
>
  <main class="px-4 pt-24 md:pt-32">
    <SectionContainer class="pb-8 md:pb-12">
      <a
        href={projectListPath}
        class="inline-flex items-center gap-2 rounded-md text-sm font-medium text-gray-600 transition hover:text-yellow-600 focus:outline-none focus-visible:ring focus-visible:ring-yellow-500/80 dark:text-gray-300 dark:hover:text-yellow-400"
      >
        <span aria-hidden="true">←</span>
        {copy.caseStudyUi.backToProjects}
      </a>

      <div class="mt-10 max-w-3xl">
        <div class="max-w-3xl">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-yellow-600 dark:text-yellow-400">
            {copy.caseStudyUi.eyebrow}
          </p>
          <h1 class="text-balance text-4xl font-bold leading-tight text-gray-900 sm:text-5xl dark:text-gray-100">
            {projectCopy.title}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
            {projectCopy.description}
          </p>
        </div>

      </div>
    </SectionContainer>

    <SectionContainer class="pb-12 md:pb-20">
      <figure
        transition:name={`project-image-${project.id}`}
        class="overflow-hidden rounded-2xl border border-gray-200 bg-gray-100 shadow-2xl shadow-gray-950/10 dark:border-gray-800 dark:bg-gray-900 dark:shadow-black/30"
      >
        <img
          src={project.image}
          alt={`${copy.projectsUi.imageAlt}: ${projectCopy.title}`}
          width="1200"
          height="675"
          class="aspect-video w-full object-cover object-top"
        />
      </figure>
    </SectionContainer>

    <SectionContainer class="pb-12 md:pb-20">
      <div class="rounded-2xl border border-gray-200 bg-white/60 p-6 shadow-sm backdrop-blur md:p-8 dark:border-gray-800 dark:bg-gray-900/50">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
          {copy.caseStudyUi.technologies}
        </h2>
        <ProjectTags tags={project.tags} />
      </div>
    </SectionContainer>

    <SectionContainer class="pb-12 md:pb-20">
      <div class="rounded-2xl border border-gray-200 bg-white/60 p-6 shadow-sm backdrop-blur md:p-8 dark:border-gray-800 dark:bg-gray-900/50">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
          {copy.caseStudyUi.resources}
        </h2>
        <div class="mt-5 grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400">
              {copy.projectsUi.preview}
            </h3>
            {project.preview.status === "available" ? (
              <LinkButton href={project.preview.url}>
                <LinkIcon class="size-4" />
                {copy.projectsUi.preview}
              </LinkButton>
            ) : (
              <span
                aria-disabled="true"
                class="inline-flex cursor-not-allowed items-center justify-center rounded-xl border border-gray-300 bg-gray-100 px-3 py-2 text-base text-gray-500 opacity-75 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
              >
                {copy.projectsUi.comingSoon}
              </span>
            )}
          </div>
          {project.repositories.length > 0 && (
            <div>
              <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400">
                {copy.caseStudyUi.repositories}
              </h3>
              <div class="flex flex-wrap gap-3">
                {project.repositories.map((repository) => (
                  <LinkButton href={repository.url}>
                    <GitHubIcon class="size-5" />
                    {repository.label[locale]}
                  </LinkButton>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </SectionContainer>

    <SectionContainer class="pb-12 md:pb-20">
      <CaseStudyBlocks sections={article.sections} contentsLabel={copy.caseStudyUi.contents} />
    </SectionContainer>

    <SectionContainer class="pb-10">
      <a
        href={projectListPath}
        class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-gray-100 px-4 py-2.5 font-medium text-gray-800 transition hover:border-gray-900 hover:bg-gray-800 hover:text-white focus:outline-none focus-visible:ring focus-visible:ring-yellow-500/80 focus-visible:ring-offset-2 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:hover:border-gray-500 dark:hover:bg-gray-700 dark:focus-visible:ring-offset-neutral-950"
      >
        <span aria-hidden="true">←</span>
        {copy.caseStudyUi.backToProjects}
      </a>
    </SectionContainer>
  </main>
</Layout>
